# =============================================================================
# SaaS Admin API — Environment variables (local development)
# =============================================================================
# 1. Copy this file:  copy .env.example .env
# 2. Edit DATABASE_URL and JWT_SECRET to match your machine
# 3. See SETUP.md for PostgreSQL + pgAdmin steps
# =============================================================================

NODE_ENV=development
PORT=3000

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
#
# Default local values (match pgAdmin / PostgreSQL install):
#   User:     postgres
#   Password: postgres          ← change if you set a different password at install
#   Host:     localhost
#   Port:     5432
#   Database: saas_admin       ← create this database in pgAdmin first
#
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/saas_admin?schema=public

# -----------------------------------------------------------------------------
# JWT (required: at least 32 characters)
# -----------------------------------------------------------------------------
# Generate a secure secret (PowerShell):
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
# Or (Git Bash / WSL):
#   openssl rand -base64 48
#
JWT_SECRET=dev-only-change-this-to-a-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# CORS — comma-separated frontend URLs (no trailing slash)
# -----------------------------------------------------------------------------
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# -----------------------------------------------------------------------------
# Logging: error | warn | info | http | verbose | debug | silly
# -----------------------------------------------------------------------------
LOG_LEVEL=info

# =============================================================================
# Production (Render / Railway / VPS) — example only, do not commit real secrets
# =============================================================================
# NODE_ENV=production
# PORT=3000
# DATABASE_URL=postgresql://user:pass@host:5432/dbname?schema=public
# JWT_SECRET=<64+ char random from your secrets manager>
# CORS_ORIGIN=https://your-frontend.onrender.com
